[Unit]
Description=Trick or Hack CTF Platform
After=network.target

[Service]
User=ctf
WorkingDirectory=/opt/trickorhack/platform
Environment="PATH=/opt/trickorhack/platform/venv/bin"
ExecStart=/opt/trickorhack/platform/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
